{
  "name": "virtual-dewy",
  "version": "0.1.0",
  "description": "Virtual platform for Dewy, the ESP32-S3 desk buddy: runs the real firmware logic in a browser with virtual, wireable hardware.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "build:wasm": "node wasm/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
